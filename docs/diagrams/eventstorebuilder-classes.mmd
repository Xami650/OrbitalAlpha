classDiagram
    class EventStoreBuilderMain {
        +main(String[] args)
    }
    class EventStoreController {
        -EventStore store
        -EventSubscriber subscriber
        +start()
    }
    class EventStore {
        &lt;&lt;interface&gt;&gt;
        +store(String topic, String jsonEvent)
    }
    class FileEventStore {
        +store(String topic, String jsonEvent)
    }
    class EventSubscriber {
        &lt;&lt;interface&gt;&gt;
        +subscribe(EventMessageHandler handler)
        +close()
    }
    class ActiveMqEventSubscriber {
        -String clientId
        +subscribe(EventMessageHandler handler)
        +close()
    }

    EventStoreBuilderMain --> EventStoreController
    EventStoreController --> EventStore
    EventStoreController --> EventSubscriber
    FileEventStore ..|> EventStore
    ActiveMqEventSubscriber ..|> EventSubscriber
